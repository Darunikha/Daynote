# Server
PORT=5000
NODE_ENV=development

# Database (local or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/daynote

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma separated for multiple)
CLIENT_URL=http://localhost:5173

# Cloudinary (OPTIONAL - image upload is disabled if these are blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (OPTIONAL - if these are blank, forgot-password returns the reset
# link directly in the API response instead of emailing it, so the flow
# still works end to end without a mail provider configured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Daynote <no-reply@daynote.app>
